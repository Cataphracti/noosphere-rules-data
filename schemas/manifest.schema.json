{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Cataphracti/noosphere-rules-data/blob/main/schemas/manifest.schema.json",
  "title": "Noosphere Rules Data Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestSchemaVersion",
    "channel",
    "dataRevision",
    "dataVersion",
    "displayName",
    "publishedAt",
    "minAppVersionCode",
    "requiredCapabilities",
    "pack",
    "notes"
  ],
  "properties": {
    "manifestSchemaVersion": {
      "type": "integer",
      "const": 1
    },
    "channel": {
      "type": "string",
      "enum": ["stable", "beta", "internal"]
    },
    "dataRevision": {
      "type": "integer",
      "minimum": 1
    },
    "dataVersion": {
      "type": "string",
      "minLength": 1
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "minAppVersionCode": {
      "type": "integer",
      "minimum": 0
    },
    "requiredCapabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "pack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "sizeBytes",
        "sha256",
        "signature",
        "signatureAlgorithm",
        "signaturePayload",
        "signatureKeyId"
      ],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https://github\\.com/Cataphracti/noosphere-rules-data/releases/download/rules-data-[A-Za-z0-9._-]+/noosphere-rules-pack\\.zip$"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "signature": {
          "type": "string",
          "minLength": 1
        },
        "signatureAlgorithm": {
          "const": "ed25519"
        },
        "signaturePayload": {
          "const": "sha256"
        },
        "signatureKeyId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
